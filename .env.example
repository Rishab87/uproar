# Web app (apps/web). Copy to apps/web/.env.local for local development.

# Postgres. In production, use Supabase's transaction pooler URL (port 6543), region ap-south-1.
DATABASE_URL=postgres://uproar@127.0.0.1:54329/uproar

# One or more Solana RPC URLs, comma-separated, tried in order. Keep these server-side only.
RPC_URLS=http://127.0.0.1:8899

# localnet, devnet or mainnet-beta. Picks the wallet chain and turns test-only features on or off.
NEXT_PUBLIC_CLUSTER=localnet
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the public source code link shown on /protocol.
NEXT_PUBLIC_REPO_URL=

# Country assumed when the host doesn't say. IN is the safer default for an Indian operator.
DEFAULT_COUNTRY=IN

# Long random strings: openssl rand -base64 32
CRON_SECRET=
ADMIN_SESSION_SECRET=
HELIUS_WEBHOOK_SECRET=

# Operator wallets that can sign in to /admin, comma-separated.
ADMIN_WALLETS=

# Alarms for legal deadlines. Set at least one before launch.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
