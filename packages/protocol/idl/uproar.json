  "types": [
    {
      "name": "Handle",
      "docs": [
        "A claimed name. Holds its rent plus the refundable deposit."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "profile",
            "type": "pubkey"
          },
          {
            "name": "deposit",
            "type": "u64"
          },
          {
            "name": "claimed_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Profile",
      "docs": [
        "A permanent identity. Its address never changes, so a released handle can never drag",
        "someone's old posts onto a new owner."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "creator",
            "docs": [
              "The wallet that created this profile. Immutable, and the PDA seed."
            ],
            "type": "pubkey"
          },
          {
            "name": "authority",
            "docs": [
              "The wallet that controls this profile now."
            ],
            "type": "pubkey"
          },
          {
            "name": "handle",
            "type": {
              "array": [
                "u8",
                15
              ]
            }
          },
          {
            "name": "handle_len",
            "docs": [
              "Zero means no handle."
            ],
            "type": "u8"
          },
          {
            "name": "session_epoch",
            "docs": [
              "Sessions from any other epoch are dead. Seeded from the slot and only ever moves forward,",
              "so closing and recreating a profile cannot revive a revoked session."
            ],
            "type": "u64"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Session",
      "docs": [
        "Lets a delegate key perform social actions for a profile until it expires."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "profile",
            "type": "pubkey"
          },
          {
            "name": "delegate",
            "type": "pubkey"
          },
          {
            "name": "rent_payer",
            "docs": [
              "Receives the rent back when the session closes, whoever closes it."
            ],
            "type": "pubkey"
          },
          {
            "name": "expires_at",
            "type": "i64"
          },
          {
            "name": "epoch",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    }
  ],
  "constants": [
    {
      "name": "DEPOSIT_3_CHAR",
      "docs": [
        "Refundable handle deposits, in lamports. The deposit is the spam wall: it costs nothing to keep",
